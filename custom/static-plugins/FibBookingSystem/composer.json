{
  "name": "fib/fib-booking-system",
  "description": "Booking and reservation system plugin for Shopware 6.",
  "version": "1.0.0",
  "type": "shopware-platform-plugin",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "FibBookingSystem\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FibBookingSystem\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "extra": {
    "shopware-plugin-class": "FibBookingSystem\\FibBookingSystem",
    "label": {
      "de-DE": "FIB Buchungssystem",
      "en-GB": "FIB Booking System"
    },
    "description": {
      "de-DE": "Technisch sauberes Reservierungs- und Buchungssystem fuer Shopware.",
      "en-GB": "Clean reservation and booking system for Shopware."
    }
  },
  "require": {
    "chillerlan/php-qrcode": "^5.0",
    "ext-gd": "*",
    "ext-openssl": "*",
    "ext-zip": "*",
    "shopware/core": "~6.5.0 || ~6.6.0 || ~6.7.0",
    "shopware/storefront": "~6.5.0 || ~6.6.0 || ~6.7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
