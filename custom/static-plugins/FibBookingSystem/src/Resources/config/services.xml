<?xml version="1.0" ?>

<!-- Thin index only: every service lives in its responsibility-scoped file
     under services/. New services belong there, not here. -->
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <imports>
        <import resource="services/entities.xml"/>
        <import resource="services/security.xml"/>
        <import resource="services/booking.xml"/>
        <import resource="services/seating.xml"/>
        <import resource="services/ticketing.xml"/>
        <import resource="services/wallet.xml"/>
        <import resource="services/resale.xml"/>
        <import resource="services/checkout.xml"/>
        <import resource="services/storefront.xml"/>
        <import resource="services/maintenance.xml"/>
    </imports>
</container>
