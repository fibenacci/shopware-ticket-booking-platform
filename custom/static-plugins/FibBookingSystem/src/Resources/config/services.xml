<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <service id="FibBookingSystem\Core\Content\BookingResource\BookingResourceDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_resource"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingReservation\BookingReservationDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_reservation"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingTicket\BookingTicketDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_ticket"/>
        </service>

        <service id="FibBookingSystem\Core\Content\ProductBookingConfig\ProductBookingConfigDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_product_config"/>
        </service>

        <service id="FibBookingSystem\Extension\Content\Product\ProductBookingConfigExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingHold\BookingHoldDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_hold"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingSeat\BookingSeatDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_seat"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingSeatClaim\BookingSeatClaimDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_seat_claim"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingListing\BookingListingDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_listing"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingBid\BookingBidDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_bid"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Availability\AvailabilityService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Seating\SeatClaimService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Seating\SeatmapReadService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Resale\BookingResaleService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Resale\TicketTransferService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\QrCodeGenerator"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\TokenCipher"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Resale\ListingCartReader">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Resale\ListingReadService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Resale\ResaleSettlementService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\TicketTransferService"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Seating\SeatmapUpdatePublisher">
            <argument type="service" id="mercure.hub.default"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Reservation\BookingHoldService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="fib_booking_hold.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Availability\AvailabilityService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatClaimService"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Reservation\BookingHoldExpirationService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatClaimService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatmapUpdatePublisher"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Reservation\BookingReservationExpirationService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Reservation\BookingReservationService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="fib_booking_hold.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\BookingTicketService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Availability\AvailabilityService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatClaimService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatmapUpdatePublisher"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Validity\TicketValidityResolver"/>

        <service id="FibBookingSystem\Core\Domain\Reservation\BookingPassReservationService">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="fib_booking_product_config.repository"/>
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Validity\TicketValidityResolver"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\BookingTicketService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="event_dispatcher"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\QrCodeGenerator"/>
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\TokenCipher"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Validity\TicketValidityResolver"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Security\TokenCipher">
            <argument>%kernel.secret%</argument>
        </service>

        <service id="fib_booking.rate_limiter.storage" class="Symfony\Component\RateLimiter\Storage\CacheStorage">
            <argument type="service" id="cache.app"/>
        </service>

        <service id="fib_booking.rate_limiter.read" class="Symfony\Component\RateLimiter\RateLimiterFactory">
            <argument type="collection">
                <argument key="id">fib_booking_read</argument>
                <argument key="policy">sliding_window</argument>
                <argument key="limit">120</argument>
                <argument key="interval">1 minute</argument>
            </argument>
            <argument type="service" id="fib_booking.rate_limiter.storage"/>
        </service>

        <service id="fib_booking.rate_limiter.write" class="Symfony\Component\RateLimiter\RateLimiterFactory">
            <argument type="collection">
                <argument key="id">fib_booking_write</argument>
                <argument key="policy">sliding_window</argument>
                <argument key="limit">30</argument>
                <argument key="interval">1 minute</argument>
            </argument>
            <argument type="service" id="fib_booking.rate_limiter.storage"/>
        </service>

        <service id="fib_booking.rate_limiter.wallet" class="Symfony\Component\RateLimiter\RateLimiterFactory">
            <argument type="collection">
                <argument key="id">fib_booking_wallet</argument>
                <argument key="policy">sliding_window</argument>
                <argument key="limit">20</argument>
                <argument key="interval">1 minute</argument>
            </argument>
            <argument type="service" id="fib_booking.rate_limiter.storage"/>
        </service>

        <service id="fib_booking.rate_limiter.scan" class="Symfony\Component\RateLimiter\RateLimiterFactory">
            <argument type="collection">
                <argument key="id">fib_booking_scan</argument>
                <argument key="policy">sliding_window</argument>
                <argument key="limit">120</argument>
                <argument key="interval">1 minute</argument>
            </argument>
            <argument type="service" id="fib_booking.rate_limiter.storage"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter">
            <argument type="service" id="fib_booking.rate_limiter.read"/>
            <argument type="service" id="fib_booking.rate_limiter.write"/>
            <argument type="service" id="fib_booking.rate_limiter.wallet"/>
            <argument type="service" id="fib_booking.rate_limiter.scan"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Wallet\WalletLinkSigner">
            <argument>%kernel.secret%</argument>
        </service>

        <service id="FibBookingSystem\Core\Domain\Wallet\AppleWalletPassGenerator">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument>%kernel.project_dir%</argument>
        </service>

        <service id="FibBookingSystem\Core\Domain\Wallet\GoogleWalletLinkGenerator">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Wallet\WalletPassService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\TokenCipher"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\AppleWalletPassGenerator"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\GoogleWalletLinkGenerator"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\WalletLinkSigner"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\QrCodeGenerator"/>

        <service id="FibBookingSystem\Core\Content\BookingScanLog\BookingScanLogDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_scan_log"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\TicketScanService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="fib_booking_scan_log.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Statistics\BookingStatisticsService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\BookingTicketMailSubscriber">
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="mail_template.repository"/>
            <argument type="service" id="sales_channel_domain.repository"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\WalletPassService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\TicketDocumentService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Ticket PDF as a regular order document (admin order detail) -->
        <service id="FibBookingSystem\Checkout\Document\BookingTicketRenderer">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentConfigLoader"/>
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentFileRendererRegistry"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\TokenCipher"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\QrCodeGenerator"/>
            <tag name="document.renderer"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\TicketDocumentService">
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentGenerator"/>
            <argument type="service" id="document.repository"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\BookingTicketDocumentSubscriber">
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\TicketDocumentService"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Cache\BookingCacheSubscriber">
            <argument type="service" id="Shopware\Core\Framework\Adapter\Cache\CacheInvalidator"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Storefront\Subscriber\ProductBookingConfigCriteriaSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Rule\BookingLineItemInCartRule">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="FibBookingSystem\Flow\Action\IssueBookingTicketAction">
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\BookingTicketService"/>
            <tag name="flow.action" key="action.fib_booking.issue_ticket"/>
        </service>

        <service id="FibBookingSystem\Core\Content\BookingSlot\BookingSlotDefinition">
            <tag name="shopware.entity.definition" entity="fib_booking_slot"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Availability\BookingCalendarService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Cms\FibBookingCalendarCmsElementResolver">
            <argument type="service" id="fib_booking_resource.repository"/>
            <argument type="service" id="fib_booking_product_config.repository"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="FibBookingSystem\Command\GenerateBookingSlotsCommand">
            <argument type="service" id="fib_booking_resource.repository"/>
            <argument type="service" id="fib_booking_slot.repository"/>
            <tag name="console.command"/>
        </service>

        <service id="FibBookingSystem\Command\IssueTicketsCommand">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\BookingTicketService"/>
            <tag name="console.command"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingCalendarRoute" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Availability\BookingCalendarService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingCalendarRoute"
                 alias="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingCalendarRoute"/>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingAvailabilityRoute" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Availability\AvailabilityService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingHoldRoute" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingHoldService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatmapUpdatePublisher"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingAvailabilityRoute"
                 alias="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingAvailabilityRoute"/>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingHoldRoute"
                 alias="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingHoldRoute"/>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingSeatmapRoute" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Seating\SeatmapReadService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingSeatmapRoute"
                 alias="FibBookingSystem\Core\Content\Booking\SalesChannel\BookingSeatmapRoute"/>

        <service id="FibBookingSystem\Storefront\Controller\BookingApiController" public="true">
            <argument type="service" id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingAvailabilityRoute"/>
            <argument type="service" id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingHoldRoute"/>
            <argument type="service" id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingCalendarRoute"/>
            <argument type="service" id="FibBookingSystem\Core\Content\Booking\SalesChannel\AbstractBookingSeatmapRoute"/>
            <argument type="service" id="FibBookingSystem\Checkout\Cart\BookingLineItemFactory"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Storefront\Controller\BookingWalletController" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\WalletPassService"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\ListingReadService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Storefront\Controller\BookingResaleController" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\BookingResaleService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\ListingReadService"/>
            <argument type="service" id="FibBookingSystem\Checkout\Cart\Resale\ResaleLineItemFactory"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Api\Controller\BookingTicketScanController" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\TicketScanService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Api\Controller\BookingStatisticsController" public="true">
            <argument type="service" id="FibBookingSystem\Core\Domain\Statistics\BookingStatisticsService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\BookingRateLimiter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="FibBookingSystem\Checkout\Cart\BookingLineItemFactory"/>

        <service id="FibBookingSystem\Checkout\Cart\Resale\ResaleLineItemFactory">
            <tag name="shopware.cart.line_item.factory"/>
        </service>

        <service id="FibBookingSystem\Checkout\Cart\Resale\ResaleCartProcessor">
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\ListingCartReader"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <tag name="shopware.cart.collector"/>
            <tag name="shopware.cart.processor" priority="4100"/>
        </service>

        <service id="FibBookingSystem\Checkout\Cart\BookingCartProcessor">
            <argument type="service" id="fib_booking_hold.repository"/>
            <argument type="service" id="fib_booking_product_config.repository"/>
            <tag name="shopware.cart.processor" priority="4100"/>
        </service>

        <service id="FibBookingSystem\Checkout\Cart\BookingPassStartDateSubscriber">
            <argument type="service" id="request_stack"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Checkout\Order\BookingOrderPlacedSubscriber">
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingReservationService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingPassReservationService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Checkout\Payment\BookingPaymentStateSubscriber">
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingReservationService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Resale\ResaleSettlementService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Ticket\BookingScanLogRetentionService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\Core\Domain\Availability\BookingConsistencyCheckService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\BookingConsistencyCheckTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\BookingConsistencyCheckTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Availability\BookingConsistencyCheckService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\AnonymizeScanLogTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\AnonymizeScanLogTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\BookingScanLogRetentionService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\ExpireBookingHoldsTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="FibBookingSystem\ScheduledTask\ExpireBookingHoldsTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingHoldExpirationService"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Reservation\BookingReservationExpirationService"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
