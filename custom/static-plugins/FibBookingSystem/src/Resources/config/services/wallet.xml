<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <!-- Apple/Google wallet passes and signed download links. -->

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <service id="FibBookingSystem\Core\Domain\Wallet\WalletLinkSigner">
            <argument>%kernel.secret%</argument>
        </service>
        <service id="FibBookingSystem\Core\Domain\Wallet\AppleWalletPassGenerator">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument>%kernel.project_dir%</argument>
        </service>
        <service id="FibBookingSystem\Core\Domain\Wallet\GoogleWalletLinkGenerator">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>
        <service id="FibBookingSystem\Core\Domain\Wallet\WalletPassService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="fib_booking_ticket.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Security\TokenCipher"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\AppleWalletPassGenerator"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\GoogleWalletLinkGenerator"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Wallet\WalletLinkSigner"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\QrCodeGenerator"/>
        </service>
    </services>
</container>
