{% sw_extends '@Storefront/storefront/page/content/index.html.twig' %}

{% block base_main_inner %}
    <div class="container my-4 fib-booking-resale-index">
        <h1 class="h3 mb-1">{{ 'fibBooking.resale.headline'|trans|sw_sanitize }}</h1>
        <p class="text-muted mb-4">{{ 'fibBooking.resale.subline'|trans|sw_sanitize }}</p>

        {% if listings is empty %}
            <div class="alert alert-info" role="alert">
                {{ 'fibBooking.resale.noListings'|trans|sw_sanitize }}
            </div>
        {% endif %}

        <div class="row g-3">
            {% for listing in listings %}
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 fib-booking-resale-card">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 mb-1">{{ listing.resource_name }}</h2>
                            <p class="mb-1 text-muted">
                                {{ listing.starts_at|format_datetime('medium', 'short') }}
                                &ndash; {{ listing.ends_at|format_datetime('medium', 'short') }}
                            </p>
                            {% if listing.seat_label %}
                                <p class="mb-1">
                                    <strong>{{ 'fibBooking.resale.seat'|trans|sw_sanitize }}:</strong>
                                    {{ listing.seat_label }}
                                </p>
                            {% endif %}

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3">
                                <span class="h5 mb-0">{{ listing.ask_price|currency }}</span>
                                {% if context.customer and not context.customer.guest %}
                                    <form method="post"
                                          action="{{ path('frontend.fib_booking.resale.buy', { listingId: listing.listing_id }) }}">
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            {{ 'fibBooking.resale.buyButton'|trans|sw_sanitize }}
                                        </button>
                                    </form>
                                {% else %}
                                    <a class="btn btn-outline-primary btn-sm"
                                       href="{{ path('frontend.account.login.page') }}">
                                        {{ 'fibBooking.resale.loginToBuy'|trans|sw_sanitize }}
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
