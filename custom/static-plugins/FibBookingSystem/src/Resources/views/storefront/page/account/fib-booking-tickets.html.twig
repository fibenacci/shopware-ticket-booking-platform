{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    <div class="account-fib-booking-tickets">
        <h1 class="h3">{{ 'fibBooking.account.ticketsHeadline'|trans|sw_sanitize }}</h1>

        {% if tickets is empty %}
            <div class="alert alert-info" role="alert">
                {{ 'fibBooking.account.noTickets'|trans|sw_sanitize }}
            </div>
        {% endif %}

        {% for ticket in tickets %}
            <div class="card mb-3 fib-booking-ticket-card" data-ticket-number="{{ ticket.ticketNumber }}">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        {% if ticket.rotatingQrEnabled %}
                            {# Rotating ticket: the QR is fetched live and refreshed
                               every window — a screenshot expires within seconds. #}
                            <div class="fib-booking-ticket-qr fib-rotating-qr"
                                 data-fib-rotating-qr="true"
                                 data-fib-rotating-qr-options="{{ {
                                     codeUrl: path('frontend.account.fib_booking.tickets.rotating_qr', { ticketId: ticket.ticketId }),
                                     alt: 'fibBooking.account.qrAlt'|trans|striptags,
                                 }|json_encode }}">
                                <div class="fib-rotating-qr-image" aria-live="polite"></div>
                                <div class="fib-rotating-qr-countdown" role="timer"></div>
                            </div>
                        {% elseif ticket.qrCodeDataUri %}
                            <div class="fib-booking-ticket-qr">
                                <img src="{{ ticket.qrCodeDataUri }}"
                                     alt="{{ 'fibBooking.account.qrAlt'|trans|striptags }}"
                                     width="132"
                                     height="132"
                                     loading="lazy">
                            </div>
                        {% endif %}
                        <div class="flex-grow-1">
                            <h2 class="h5 mb-1">{{ ticket.resourceName }}</h2>
                            <p class="mb-1 text-muted">
                                {{ ticket.startsAt|format_datetime('medium', 'short') }}
                                &ndash; {{ ticket.endsAt|format_datetime('medium', 'short') }}
                            </p>
                            <p class="mb-1">
                                <strong>{{ 'fibBooking.account.ticketNumber'|trans|sw_sanitize }}:</strong> {{ ticket.ticketNumber }}<br>
                                <strong>{{ 'fibBooking.account.bookingNumber'|trans|sw_sanitize }}:</strong> {{ ticket.bookingNumber }}<br>
                                <strong>{{ 'fibBooking.account.quantity'|trans|sw_sanitize }}:</strong> {{ ticket.quantity }}
                            </p>
                            <span class="badge {{ ticket.status == 'scanned' ? 'bg-secondary' : 'bg-success' }}">
                                {{ ('fibBooking.account.status.' ~ ticket.status)|trans|sw_sanitize }}
                            </span>
                        </div>

                        <div class="d-flex flex-column gap-2 fib-booking-wallet-buttons">
                            {% if ticket.appleParams %}
                                <a class="btn btn-dark btn-sm"
                                   rel="nofollow noopener"
                                   href="{{ path('frontend.fib_booking.wallet.apple', { ticketId: ticket.ticketId, exp: ticket.appleParams.exp, sig: ticket.appleParams.sig }) }}">
                                    {{ 'fibBooking.account.addToAppleWallet'|trans|sw_sanitize }}
                                </a>
                            {% endif %}
                            {% if ticket.googleParams %}
                                <a class="btn btn-outline-dark btn-sm"
                                   rel="nofollow noopener"
                                   href="{{ path('frontend.fib_booking.wallet.google', { ticketId: ticket.ticketId, exp: ticket.googleParams.exp, sig: ticket.googleParams.sig }) }}">
                                    {{ 'fibBooking.account.addToGoogleWallet'|trans|sw_sanitize }}
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    {% set listing = resaleListings[ticket.ticketId] ?? null %}
                    {% if listing %}
                        <div class="border-top mt-3 pt-3 d-flex justify-content-between align-items-center flex-wrap gap-2 fib-booking-resale-state">
                            <span>
                                {{ 'fibBooking.resale.listedAt'|trans|sw_sanitize }}
                                <strong>{{ listing.askPrice|currency }}</strong>
                            </span>
                            {% if listing.status == 'pending' %}
                                {# A buyer order is in flight — not cancellable. #}
                                <span class="badge bg-warning text-dark">
                                    {{ 'fibBooking.resale.salePending'|trans|sw_sanitize }}
                                </span>
                            {% else %}
                                <form method="post"
                                      action="{{ path('frontend.account.fib_booking.resale.cancel', { listingId: listing.listingId }) }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        {{ 'fibBooking.resale.cancelListing'|trans|sw_sanitize }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% elseif ticket.status in ['issued', 'sent'] %}
                        <form method="post"
                              class="border-top mt-3 pt-3 d-flex align-items-end gap-2 flex-wrap fib-booking-resale-sell"
                              action="{{ path('frontend.account.fib_booking.resale.sell', { ticketId: ticket.ticketId }) }}">
                            <div>
                                <label class="form-label mb-1" for="fib-resale-price-{{ ticket.ticketId }}">
                                    {{ 'fibBooking.resale.priceLabel'|trans|sw_sanitize }}
                                </label>
                                <input type="text"
                                       inputmode="decimal"
                                       class="form-control form-control-sm"
                                       id="fib-resale-price-{{ ticket.ticketId }}"
                                       name="askPrice"
                                       placeholder="0.00"
                                       required>
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                {{ 'fibBooking.resale.sellButton'|trans|sw_sanitize }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
