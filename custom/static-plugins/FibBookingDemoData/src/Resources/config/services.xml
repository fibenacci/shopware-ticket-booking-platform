<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="FibBookingDemoData\Service\BookingDemoDataSeeder">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="tax.repository"/>
            <argument type="service" id="fib_booking_resource.repository"/>
            <argument type="service" id="fib_booking_product_config.repository"/>
            <argument type="service" id="fib_booking_reservation.repository"/>
            <argument type="service" id="fib_booking_slot.repository"/>
            <argument type="service" id="FibBookingSystem\Core\Domain\Ticket\BookingTicketService"/>
        </service>

        <service id="FibBookingDemoData\Command\SeedDemoDataCommand">
            <argument type="service" id="FibBookingDemoData\Service\BookingDemoDataSeeder"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
