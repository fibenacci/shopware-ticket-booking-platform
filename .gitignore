/.env.*.local

# Runtime artifacts in mounted dirs
/public/bundles/
/public/theme/
/public/media/
/public/thumbnail/
/public/sitemap/
/files/
/install.lock

# Tooling caches
.phpunit.cache/
.php-cs-fixer.cache
node_modules/
/custom/static-plugins/*/playwright-report/
/custom/static-plugins/*/test-results/
/custom/static-plugins/*/.phpunit.cache/
/custom/static-plugins/*/apps/*/dist/
/custom/static-plugins/*/build/
/junit-artifacts/

# Compiled plugin assets — rebuilt by `shopware-cli project ci` at image
# build (see Dockerfile), so they must NOT be committed. NOTE: the standalone
# Vue islands (apps/* → Resources/public/<island>/) are deploy artifacts the
# Shopware build does NOT regenerate — those stay tracked (e.g. seat-picker).
/custom/static-plugins/*/src/Resources/public/administration/
/custom/static-plugins/*/src/Resources/app/storefront/dist/

