# Local development overrides — copied to .env.local by `make up` (preflight).
# .env.local is gitignored; change values there, not here.

APP_ENV=dev
APP_URL=http://booking.docker
APP_SECRET=devsecret-change-me-in-production
DATABASE_URL=mysql://root:root@mariadb:3306/shopware

# Mailpit (UI: http://mail.booking.docker or http://127.0.0.1:8095)
MAILER_DSN=smtp://mailpit:1025

# Symfony lock component — filesystem locks, no external dependency needed in dev.
LOCK_DSN=flock

# Messenger — synchronous-friendly doctrine transport in dev.
MESSENGER_TRANSPORT_DSN=doctrine://default

# Redis (compose service `redis`, password `redis`) — available if you wire
# cache/session pools to it in config/packages/.
REDIS_DSN=redis://:redis@redis:6379

# Dev conveniences
SHOPWARE_HTTP_CACHE_ENABLED=0
SHOPWARE_ES_ENABLED=0

# Optional: public HTTPS tunnel to the scanner app (`make scanner-ngrok`).
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
